@@ -0,0 +1,48 @@
+import { BadRequestException } from "@nestjs/common";
+import { DEFAULT_PRINT_PROFILE } from "@kudos/shared-types";
+import type { PlatformSettingsService } from "../billing/platform-settings.service";
+import { PrintProfileService } from "./print-profile.service";
+
+function service(stored: string | null) {
+  const store = { value: stored };
+  const settings = {
+    get: () => Promise.resolve(store.value),
+    set: (_key: string, value: string) => {
+      store.value = value;
+      return Promise.resolve();
+    },
+  } as unknown as PlatformSettingsService;
+  return { service: new PrintProfileService(settings), store };
+}
+
+describe("PrintProfileService", () => {
+  it("falls back to the house default when nothing is stored", async () => {
+    await expect(service(null).service.get()).resolves.toEqual(DEFAULT_PRINT_PROFILE);
+  });
+
+  it("falls back to the default on a corrupt or invalid value rather than failing a print", async () => {
+    await expect(service("not json").service.get()).resolves.toEqual(DEFAULT_PRINT_PROFILE);
+    await expect(service(JSON.stringify({ layout: "sideways" })).service.get()).resolves.toEqual(
+      DEFAULT_PRINT_PROFILE,
+    );
+  });
+
+  it("round-trips a valid profile", async () => {
+    const { service: s, store } = service(null);
+    const next = {
+      layout: "folded-sheet",
+      backFooter: "print",
+      borderlessExtensionMm: 1.5,
+    } as const;
+    await expect(s.set(next)).resolves.toEqual(next);
+    expect(JSON.parse(store.value!)).toEqual(next);
+    await expect(s.get()).resolves.toEqual(next);
+  });
+
+  it("refuses an extension no printer produces", async () => {
+    const { service: s } = service(null);
+    await expect(
+      s.set({ layout: "folded-sheet", backFooter: "reserved", borderlessExtensionMm: 25 }),
+    ).rejects.toBeInstanceOf(BadRequestException);
+  });
+});
