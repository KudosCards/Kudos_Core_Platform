--- /dev/null
+++ b/apps/api/src/print-profile/print-profile.service.ts
@@ -0,0 +1,54 @@
+import { BadRequestException, Injectable, Logger } from "@nestjs/common";
+import { DEFAULT_PRINT_PROFILE, printProfileSchema, type PrintProfile } from "@kudos/shared-types";
+import {
+  PlatformSettingsService,
+  PLATFORM_SETTING_KEYS,
+} from "../billing/platform-settings.service";
+
+/**
+ * The house print setup (`PrintProfile`), stored as one JSON platform setting.
+ *
+ * Same shape as `CardSizeConfigService`: a super admin sets it, the print run
+ * reads it, and a missing or unreadable value falls back to the default rather
+ * than failing a print. The default is the physical setup as it stands (A5
+ * blanks folded to A6, pre-printed back strip, uncalibrated printer); the
+ * calibration print is what turns `borderlessExtensionMm` into a real number.
+ */
+@Injectable()
+export class PrintProfileService {
+  private readonly logger = new Logger(PrintProfileService.name);
+
+  constructor(private readonly settings: PlatformSettingsService) {}
+
+  async get(): Promise<PrintProfile> {
+    const raw = await this.settings.get(PLATFORM_SETTING_KEYS.printProfile);
+    if (raw === null) return DEFAULT_PRINT_PROFILE;
+    try {
+      const parsed = printProfileSchema.safeParse(JSON.parse(raw));
+      if (parsed.success) return parsed.data;
+      this.logger.warn("Stored print profile failed validation — using the default");
+    } catch {
+      this.logger.warn("Stored print profile is not JSON — using the default");
+    }
+    return DEFAULT_PRINT_PROFILE;
+  }
+
+  getDefault(): PrintProfile {
+    return DEFAULT_PRINT_PROFILE;
+  }
+
+  async set(value: unknown): Promise<PrintProfile> {
+    const parsed = printProfileSchema.safeParse(value);
+    if (!parsed.success) {
+      throw new BadRequestException(
+        `Invalid print profile: ${parsed.error.issues.map((i) => i.message).join(", ")}`,
+      );
+    }
+    await this.settings.set(PLATFORM_SETTING_KEYS.printProfile, JSON.stringify(parsed.data));
+    this.logger.log(
+      `Print profile updated: ${parsed.data.layout}, footer ${parsed.data.backFooter}, ` +
+        `borderless extension ${parsed.data.borderlessExtensionMm}mm`,
+    );
+    return parsed.data;
+  }
+}
