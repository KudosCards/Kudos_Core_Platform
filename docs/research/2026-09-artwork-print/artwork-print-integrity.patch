+import {
+  CARD_HEIGHT,
+  CARD_WIDTH,
+  DISTORTION_OK_BELOW,
+  backgroundArtworkVerdict,
+  customArtworkDocument,
+  elementDistortion,
+  idealArtworkPixels,
+  newMemberBackgroundUrls,
+  orientedPixelSize,
+  type DesignDocument,
+} from "@kudos/shared-types";
+
+/**
+ * The rule a background has to pass before it becomes a card. Pinned against
+ * the real cases: the 2:3 catalog export that lost 6% of its height on 207
+ * designs, the A6 export that fixes it, and the phone photo whose header lies
+ * about which way up it is. See docs/card-artwork-print-integrity.md.
+ */
+describe("backgroundArtworkVerdict", () => {
+  it("accepts the artwork brief exactly — 1240 × 1748 clears shape and pixels at once", () => {
+    expect(backgroundArtworkVerdict(idealArtworkPixels("A6"))).toEqual({ ok: true });
+    expect(backgroundArtworkVerdict({ width: 1240, height: 1748 })).toEqual({ ok: true });
+  });
+
+  it("accepts an A5 master (1748 × 2480) for an A6 card — same shape, more pixels", () => {
+    expect(backgroundArtworkVerdict(idealArtworkPixels("A5"))).toEqual({ ok: true });
+  });
+
+  it("refuses the 2:3 export that cropped 207 catalog designs, naming the loss and the fix", () => {
+    const verdict = backgroundArtworkVerdict({ width: 1000, height: 1500 });
+    expect(verdict.ok).toBe(false);
+    if (verdict.ok) return;
+    expect(verdict.reason).toBe("shape");
+    expect(verdict.message).toContain("6% of its height");
+    expect(verdict.message).toContain("4.5mm off each of the top and bottom");
+    expect(verdict.message).toContain("1240 × 1748");
+  });
+
+  it("refuses a square source (29% of its width gone)", () => {
+    const verdict = backgroundArtworkVerdict({ width: 2000, height: 2000 });
+    expect(verdict).toMatchObject({ ok: false, reason: "shape" });
+  });
+
+  it("checks shape before pixels: a wrong-shaped file is re-exported, which fixes both", () => {
+    // Tiny *and* square: the message must send them to a re-export, not to a
+    // bigger square.
+    const verdict = backgroundArtworkVerdict({ width: 300, height: 300 });
+    expect(verdict).toMatchObject({ ok: false, reason: "shape" });
+  });
+
+  it("refuses the right shape with too few pixels (below 200 dpi on A6)", () => {
+    // A6-shaped, but 620 × 874 is 150 dpi.
+    const verdict = backgroundArtworkVerdict({ width: 620, height: 874 });
+    expect(verdict.ok).toBe(false);
+    if (verdict.ok) return;
+    expect(verdict.reason).toBe("resolution");
+    expect(verdict.message).toContain("150 dpi");
+    expect(verdict.message).toContain("1240 × 1748");
+  });
+
+  it("accepts the right shape in the 'acceptable' band (200–300 dpi) — advisory, not refused", () => {
+    // 900 × 1269 ≈ 218 dpi on A6. The editor still shows the amber note.
+    expect(backgroundArtworkVerdict({ width: 900, height: 1269 })).toEqual({ ok: true });
+  });
+
+  it("refuses at exactly the 200 dpi floor, as the resolution pre-flight does", () => {
+    // printDpiVerdict treats dpi === PRINT_DPI_WARN_BELOW as "low".
+    // 200 dpi across 105mm is 826.77px; 826 × 1165 rounds under it.
+    expect(backgroundArtworkVerdict({ width: 826, height: 1164 })).toMatchObject({
+      ok: false,
+      reason: "resolution",
+    });
+  });
+
+  it("judges A5 against A5 pixels when asked", () => {
+    // Fine for A6, soft (~213 dpi → acceptable) on A5; still passes the floor.
+    expect(backgroundArtworkVerdict({ width: 1240, height: 1748 }, "A5")).toEqual({ ok: true });
+    // 800 × 1131 is ~137 dpi on A5.
+    expect(backgroundArtworkVerdict({ width: 800, height: 1131 }, "A5")).toMatchObject({
+      ok: false,
+      reason: "resolution",
+    });
+  });
+});
+
+describe("orientedPixelSize", () => {
+  it("swaps the axes for a rotated EXIF orientation (5–8)", () => {
+    // A phone stores this portrait photo as 1748 × 1240 with "rotate 90°".
+    expect(orientedPixelSize({ width: 1748, height: 1240, orientation: 6 })).toEqual({
+      width: 1240,
+      height: 1748,
+    });
+    expect(orientedPixelSize({ width: 1748, height: 1240, orientation: 8 })).toEqual({
+      width: 1240,
+      height: 1748,
+    });
+  });
+
+  it("leaves an unrotated or untagged image alone", () => {
+    expect(orientedPixelSize({ width: 1240, height: 1748 })).toEqual({ width: 1240, height: 1748 });
+    expect(orientedPixelSize({ width: 1240, height: 1748, orientation: 1 })).toEqual({
+      width: 1240,
+      height: 1748,
+    });
+    // 2–4 are flips, not rotations: the shape is unchanged.
+    expect(orientedPixelSize({ width: 1240, height: 1748, orientation: 3 })).toEqual({
+      width: 1240,
+      height: 1748,
+    });
+  });
+
+  it("means a rotated phone photo of the right shape passes the gate", () => {
+    const seen = orientedPixelSize({ width: 1748, height: 1240, orientation: 6 });
+    expect(backgroundArtworkVerdict(seen)).toEqual({ ok: true });
+    // …and that judging the raw header would have wrongly refused it.
+    expect(backgroundArtworkVerdict({ width: 1748, height: 1240 })).toMatchObject({ ok: false });
+  });
+});
+
+describe("elementDistortion", () => {
+  it("is zero when the box is the image's own shape", () => {
+    expect(elementDistortion({ width: 1000, height: 1500 }, { width: 200, height: 300 })).toBe(0);
+  });
+
+  it("reports the old custom-artwork flow's 450 × 600 box as a distortion of an A6 upload", () => {
+    // 1240 × 1748 (1:1.4097) forced into 3:4 (1:1.333): a 5.7% vertical squash.
+    const d = elementDistortion({ width: 1240, height: 1748 }, { width: 450, height: 600 });
+    expect(d).toBeCloseTo(0.057, 3);
+    expect(d).toBeGreaterThan(DISTORTION_OK_BELOW);
+  });
+
+  it("is symmetric in direction — a stretch and a squash of the same size read the same", () => {
+    const stretched = elementDistortion({ width: 100, height: 100 }, { width: 110, height: 100 });
+    const squashed = elementDistortion({ width: 110, height: 100 }, { width: 100, height: 100 });
+    expect(stretched).toBeCloseTo(0.1, 6);
+    expect(squashed).toBeCloseTo(0.1, 6);
+  });
+
+  it("forgives a rounding-sized difference", () => {
+    // fitWithinBox rounds to whole units; 200 × 282 for a 1240 × 1748 source.
+    expect(
+      elementDistortion({ width: 1240, height: 1748 }, { width: 200, height: 282 }),
+    ).toBeLessThan(DISTORTION_OK_BELOW);
+  });
+
+  it("is zero for a degenerate size rather than NaN", () => {
+    expect(elementDistortion({ width: 0, height: 0 }, { width: 10, height: 10 })).toBe(0);
+    expect(elementDistortion({ width: 10, height: 10 }, { width: 0, height: 10 })).toBe(0);
+  });
+});
+
+describe("customArtworkDocument", () => {
+  const url = "https://x.supabase.co/storage/v1/object/public/design-assets/acc/a.png";
+
+  it("puts the upload on the front as a background, not a fixed-size element", () => {
+    const doc = customArtworkDocument(url);
+    const front = doc.pages.find((p) => p.name === "front")!;
+    expect(front.background).toEqual({ type: "image", assetUrl: url });
+    expect(front.elements).toEqual([]);
+  });
+
+  it("has all four faces, the other three blank", () => {
+    const doc = customArtworkDocument(url);
+    expect(doc.pages.map((p) => p.name)).toEqual(["front", "inside-left", "inside-right", "back"]);
+    for (const page of doc.pages.slice(1)) {
+      expect(page.elements).toEqual([]);
+      expect(page.background).toBeUndefined();
+    }
+  });
+
+  it("never pins anything to the retired 450 × 600 canvas", () => {
+    // The regression this replaces: an element sized to a canvas that grew to
+    // 634 tall in ADR 0161. Nothing in the new document carries a size at all.
+    const json = JSON.stringify(customArtworkDocument(url));
+    expect(json).not.toContain('"height":600');
+    expect(json).not.toContain(`"height":${CARD_HEIGHT}`);
+    expect(json).not.toContain(`"width":${CARD_WIDTH}`);
+  });
+});
+
+describe("newMemberBackgroundUrls", () => {
+  const member = "https://x.supabase.co/storage/v1/object/public/design-assets/acc/mine.png";
+  const catalog = "https://x.supabase.co/storage/v1/object/public/design-assets/catalog/ours.png";
+
+  function doc(backgrounds: (string | undefined)[]): DesignDocument {
+    const names = ["front", "inside-left", "inside-right", "back"] as const;
+    return {
+      version: 1,
+      pages: names.map((name, i) => ({
+        name,
+        elements: [],
+        ...(backgrounds[i]
+          ? { background: { type: "image" as const, assetUrl: backgrounds[i] } }
+          : {}),
+      })),
+    };
+  }
+
+  it("returns a member's background on a fresh design", () => {
+    expect(newMemberBackgroundUrls(doc([member]))).toEqual([member]);
+  });
+
+  it("skips catalog artwork — that is measured at the sync, and is not the customer's to fix", () => {
+    expect(newMemberBackgroundUrls(doc([catalog]))).toEqual([]);
+  });
+
+  it("skips a background the design already had, so an unrelated edit still saves", () => {
+    expect(newMemberBackgroundUrls(doc([member]), doc([member]))).toEqual([]);
+  });
+
+  it("catches a background moved to a different face only if it is new to the design", () => {
+    expect(newMemberBackgroundUrls(doc([undefined, member]), doc([member]))).toEqual([]);
+  });
+
+  it("returns a newly set background on an existing design", () => {
+    const other = member.replace("mine", "new");
+    expect(newMemberBackgroundUrls(doc([member, other]), doc([member]))).toEqual([other]);
+  });
+
+  it("deduplicates a background used on more than one face", () => {
+    expect(newMemberBackgroundUrls(doc([member, member]))).toEqual([member]);
+  });
+
+  it("ignores colour backgrounds", () => {
+    const d = doc([]);
+    d.pages[0]!.background = { type: "color", color: "#fff" };
+    expect(newMemberBackgroundUrls(d)).toEqual([]);
+  });
+});
