index 0000000..63245a2
--- /dev/null
+++ b/packages/shared-types/src/print-profile.ts
@@ -0,0 +1,69 @@
+/**
+ * How the house printer puts a card on paper — the settings that describe the
+ * physical print setup rather than any one card, so the print-ready PDF comes
+ * out shaped for the printer and stock actually in the room.
+ *
+ * Set once by a super admin (after a calibration print), stored as one JSON
+ * platform setting, read by the print run. Per-run overrides for the two
+ * choices an operator might sensibly change on the day (layout, footer) go on
+ * the request; the calibrated extension does not — it is a property of the
+ * printer, not of a run. See docs/card-artwork-print-integrity.md.
+ */
+
+import { z } from "zod";
+
+/**
+ * - `face-per-page`: one card face per page at the trim size (the original
+ *   output; right for pre-cut single-face stock or a print house that imposes).
+ * - `folded-sheet`: two faces side by side on a sheet twice the trim width
+ *   (A5 for an A6 card), outside then inside, for print-both-sides-and-fold.
+ */
+export const PRINT_LAYOUTS = ["face-per-page", "folded-sheet"] as const;
+export type PrintLayoutSetting = (typeof PRINT_LAYOUTS)[number];
+
+/**
+ * - `reserved`: the bottom 30mm of the back is pre-printed on the stock, so it
+ *   is clipped out of the render (ADR 0166).
+ * - `print`: blank stock — we print the logo and this card's QR into the strip
+ *   ourselves, in the same pass as the artwork.
+ */
+export const BACK_FOOTER_MODES = ["reserved", "print"] as const;
+export type BackFooterMode = (typeof BACK_FOOTER_MODES)[number];
+
+/** A borderless driver's overhang is a few millimetres at most; anything
+ * larger is a typo, not a printer. */
+export const MAX_BORDERLESS_EXTENSION_MM = 6;
+
+export const printProfileSchema = z.object({
+  layout: z.enum(PRINT_LAYOUTS),
+  backFooter: z.enum(BACK_FOOTER_MODES),
+  /**
+   * How far past each long edge of the paper the printer's borderless mode
+   * pushes the image, in mm — read off a calibration print. 0 means the page
+   * is printed at exactly its size and the PDF is drawn at the trim.
+   */
+  borderlessExtensionMm: z.number().min(0).max(MAX_BORDERLESS_EXTENSION_MM),
+});
+export type PrintProfile = z.infer<typeof printProfileSchema>;
+
+/**
+ * The house setup: A5 blanks folded to A6 with a pre-printed back strip, on a
+ * printer not yet calibrated. `folded-sheet` rather than `face-per-page`
+ * because that is how the cards are physically made; the old one-face-per-page
+ * output stays available as a layout for anyone who needs it.
+ */
+export const DEFAULT_PRINT_PROFILE: PrintProfile = {
+  layout: "folded-sheet",
+  backFooter: "reserved",
+  borderlessExtensionMm: 0,
+};
+
+export const PRINT_LAYOUT_LABELS: Record<PrintLayoutSetting, string> = {
+  "face-per-page": "One face per page",
+  "folded-sheet": "Folded sheet (two faces per side)",
+};
+
+export const BACK_FOOTER_LABELS: Record<BackFooterMode, string> = {
+  reserved: "Pre-printed on the stock",
+  print: "Printed with the card",
+};
