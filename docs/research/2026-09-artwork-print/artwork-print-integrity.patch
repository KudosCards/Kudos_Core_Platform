+++ b/packages/shared-types/src/card-artwork.ts
@@ -0,0 +1,212 @@
+/**
+ * The rule for artwork that is allowed onto a card, stated once.
+ *
+ * Two pre-flights already exist and both are advisory: `print-quality.ts`
+ * says whether an image has enough pixels, `card-crop.ts` says whether its
+ * shape will be cut. Nothing *refuses* — the crop plan (docs/card-artwork-
+ * crop-plan.md, D4) reserved refusal for the catalog sync, and ADR 0162
+ * deliberately left customer uploads un-gated on the argument that a hard
+ * minimum would reject small logos and stickers.
+ *
+ * That argument is right for an image *element* — a logo on a card can be any
+ * shape and is scaled to its own box. It is wrong for a *background*: a
+ * background is the card. It fills the whole face, it is centre-cropped to the
+ * card's shape, and it is printed edge to edge at trim size. A background of
+ * the wrong shape is a card with its edges cut off, every time, and one with
+ * too few pixels is a soft card, every time. Both are known the moment the
+ * file is chosen and both are cheaper to refuse than to explain later.
+ *
+ * So: **a background must be the right shape and carry enough pixels.** This
+ * module is the one definition of "right" and "enough", derived from the
+ * pre-flights it sits beside so a background that passes here is one both of
+ * them call fine. The browser applies it before an upload starts (so the
+ * customer is told with the file still in their hand) and the API applies it
+ * at the save (so nothing can route around the browser). See
+ * docs/card-artwork-print-integrity.md.
+ */
+
+import type { DesignDocument, DesignPage } from "./card";
+import { isCatalogArtwork } from "./card";
+import {
+  PRINT_RUN_BLEED_MM,
+  cropLossPerEdgeMm,
+  cropLossPercent,
+  cropVerdict,
+  croppedAxis,
+  idealArtworkPixels,
+  printedCropLoss,
+} from "./card-crop";
+import { DEFAULT_CARD_SIZE, type CardSize } from "./card-format";
+import {
+  PRINT_DPI_TARGET,
+  PRINT_DPI_WARN_BELOW,
+  backgroundPrintedSizeMm,
+  imagePrintDpi,
+  printDpiVerdict,
+  type PixelSize,
+} from "./print-quality";
+
+/**
+ * A measured image, as `sharp` metadata or the browser reports it.
+ *
+ * `orientation` is the EXIF tag (1..8). A phone photo is very often stored
+ * landscape with a tag saying "rotate me": the browser, pdfkit and every
+ * viewer honour the tag, so what everyone *sees* is portrait — but `width` and
+ * `height` in the file header are the un-rotated ones. A measurement that
+ * ignores the tag reports the wrong shape for exactly the uploads most likely
+ * to be photos. Optional, because the browser's `naturalWidth`/`naturalHeight`
+ * are already oriented and carry no tag.
+ */
+export interface MeasuredImage extends PixelSize {
+  orientation?: number;
+}
+
+/** The size an image is *seen* at, with any EXIF rotation applied. Pure. */
+export function orientedPixelSize(image: MeasuredImage): PixelSize {
+  const rotated = (image.orientation ?? 1) >= 5;
+  return rotated
+    ? { width: image.height, height: image.width }
+    : { width: image.width, height: image.height };
+}
+
+export type BackgroundArtworkVerdict =
+  | { ok: true }
+  | {
+      ok: false;
+      /** Which rule failed. Shape is checked first: a wrong-shaped file is
+       *  re-exported, and the re-export fixes the pixel count as well. */
+      reason: "shape" | "resolution";
+      /** One sentence a customer can act on, ending with the size to export at. */
+      message: string;
+    };
+
+/**
+ * Whether an image may be a page background. Pure.
+ *
+ * Judged against what the press produces (`printedCropLoss` at the shipping
+ * bleed), at the house size, exactly as the catalog sync's gate judges catalog
+ * artwork — the same rule for our artwork and the customer's. The shape floor
+ * is `cropVerdict`'s `ok` band (2% of an axis, about 1.5mm off each edge of an
+ * A6), which forgives a true-A6 export against the 634-unit canvas and nothing
+ * a person would notice. The pixel floor is the resolution pre-flight's `low`
+ * band (200dpi): an A6 background needs 827 × 1165, and the ideal 1240 × 1748
+ * clears both at once.
+ */
+export function backgroundArtworkVerdict(
+  natural: PixelSize,
+  size: CardSize = DEFAULT_CARD_SIZE,
+): BackgroundArtworkVerdict {
+  const ideal = idealArtworkPixels(size);
+  const exportAt = `Export it at ${ideal.width} × ${ideal.height} pixels (${size} at ${PRINT_DPI_TARGET} dpi) and upload that.`;
+
+  const loss = printedCropLoss(natural, { size, bleedMm: PRINT_RUN_BLEED_MM });
+  const axis = croppedAxis(loss);
+  if (axis !== null && cropVerdict(loss) !== "ok") {
+    const edge = axis === "width" ? "side" : "of the top and bottom";
+    return {
+      ok: false,
+      reason: "shape",
+      message:
+        `This image is ${natural.width} × ${natural.height} pixels, which is not the card's shape: ` +
+        `${cropLossPercent(loss)}% of its ${axis} (about ${cropLossPerEdgeMm(loss, size).toFixed(1)}mm off each ${edge}) ` +
+        `would be cut off to fill the card. ${exportAt}`,
+    };
+  }
+
+  const dpi = imagePrintDpi(natural, backgroundPrintedSizeMm(size));
+  if (printDpiVerdict(dpi) === "low") {
+    return {
+      ok: false,
+      reason: "resolution",
+      message:
+        `This image is ${natural.width} × ${natural.height} pixels, which prints at about ${Math.round(dpi)} dpi ` +
+        `across a ${size} card — below the ${PRINT_DPI_WARN_BELOW} dpi minimum, so it would look soft. ${exportAt}`,
+    };
+  }
+
+  return { ok: true };
+}
+
+/**
+ * How far an image *element*'s box departs from the image's own shape, as a
+ * fraction: 0 is undistorted, 0.1 is a 10% stretch on one axis. Pure.
+ *
+ * An element is drawn stretched to its box on every renderer (Konva's
+ * `<Image width height>`, pdfkit's `{ width, height }`), so unlike a
+ * background it never loses its edges — it loses its proportions instead,
+ * which is worse and which nothing measured. The editor locks aspect ratio by
+ * default (ADR 0069), so this catches a lock switched off, a legacy design, and
+ * the old "Upload your own artwork" flow that pinned every upload to 450 × 600.
+ */
+export function elementDistortion(natural: PixelSize, box: PixelSize): number {
+  if (natural.width <= 0 || natural.height <= 0 || box.width <= 0 || box.height <= 0) return 0;
+  const imgRatio = natural.width / natural.height;
+  const boxRatio = box.width / box.height;
+  // The larger of the two ratios over the smaller, so a 10% stretch and the
+  // 10% squash that undoes it read as the same amount of distortion.
+  return Math.max(boxRatio / imgRatio, imgRatio / boxRatio) - 1;
+}
+
+/** At or below this, a stretch is rounding rather than distortion. */
+export const DISTORTION_OK_BELOW = 0.02;
+
+/**
+ * The document a member's own uploaded artwork starts from: the artwork as a
+ * full-bleed **background** on the front, the other faces blank.
+ *
+ * A background, not an image element. The previous builder placed a 450 × 600
+ * image element on a canvas that has been 450 × 634 since ADR 0161, which did
+ * two wrong things to every custom upload at once: it left a 34-unit (~8mm on
+ * A6) white strip along the bottom, and — because an element stretches to its
+ * box — it forced whatever shape the upload was into 3:4. The catalog builder
+ * (`buildCardDocument`) was corrected for the same regression; this one was
+ * not. As a background the artwork is full-bleed, undistorted, locked under the
+ * customer's text, and measured by the same gate as everything else.
+ */
+export function customArtworkDocument(assetUrl: string): DesignDocument {
+  const front: DesignPage = {
+    name: "front",
+    elements: [],
+    background: { type: "image", assetUrl },
+  };
+  return {
+    version: 1,
+    pages: [
+      front,
+      { name: "inside-left", elements: [] },
+      { name: "inside-right", elements: [] },
+      { name: "back", elements: [] },
+    ],
+  };
+}
+
+/**
+ * The background image URLs in `document` that the customer supplied and that
+ * are new since `previous` — the ones a save-time gate should measure. Pure.
+ *
+ * Two exclusions, both deliberate. Catalog artwork is ours: it is measured at
+ * the catalog sync (the door it comes in through) and until the re-export
+ * lands most of it would fail here, which would stop a customer saving a text
+ * edit on a card whose artwork they cannot change. And a background already
+ * stored on the design was accepted once; refusing it on the next save — a
+ * renamed text box, a moved QR — would trap a customer in a design they can
+ * neither fix nor keep. The gate is on the door, not the room.
+ */
+export function newMemberBackgroundUrls(
+  document: DesignDocument,
+  previous?: DesignDocument | null,
+): string[] {
+  const before = new Set<string>();
+  for (const page of previous?.pages ?? []) {
+    if (page.background?.type === "image") before.add(page.background.assetUrl);
+  }
+  const urls: string[] = [];
+  for (const page of document.pages) {
+    const background = page.background;
+    if (background?.type !== "image") continue;
+    const url = background.assetUrl;
+    if (isCatalogArtwork(url) || before.has(url) || urls.includes(url)) continue;
+    urls.push(url);
+  }
+  return urls;
+}
