+import { BadRequestException, Inject, Injectable, Logger, Optional } from "@nestjs/common";
+import { ConfigService } from "@nestjs/config";
+import sharp from "sharp";
+import {
+  backgroundArtworkVerdict,
+  newMemberBackgroundUrls,
+  orientedPixelSize,
+  type DesignDocument,
+  type PixelSize,
+} from "@kudos/shared-types";
+import type { EnvConfig } from "../config/env.schema";
+import { fetchAssetBytes, hostOf, isHostAllowed, type FetchLike } from "../print-pdf";
+
+/** Injection token for a fetch stand-in, so tests can hand the gate fixtures
+ * instead of a network. Production leaves it unset and uses the global. */
+export const ARTWORK_GATE_FETCH = Symbol("ARTWORK_GATE_FETCH");
+
+/** Uploads are capped at 10MB by the design-assets bucket; anything larger
+ * is not one of ours and is not worth buffering to find out. */
+const MAX_ARTWORK_BYTES = 10 * 1024 * 1024;
+const FETCH_TIMEOUT_MS = 10_000;
+/** Measurements kept, by URL. A background URL is a one-off (uuid in the path),
+ * so this is a short-term memo for the save→re-save cycle, not an index. */
+const CACHE_LIMIT = 500;
+
+/**
+ * The save-time guarantee that a member's background artwork is the right
+ * shape and carries enough pixels — `backgroundArtworkVerdict`, applied where
+ * every persisted document already passes (`SavedDesignsService.parseDocument`,
+ * the choke point ADR 0171 chose for the reserved-footer rule, for the same
+ * reasons: it closes every downstream route at once and it fails with the
+ * design open in front of the customer).
+ *
+ * The browser applies the same verdict before the upload begins, so a customer
+ * who follows the happy path never meets this. It exists for everyone else: a
+ * stale tab, a forged request, a library asset chosen from the "Your uploads"
+ * picker that was uploaded before the rule, a future surface that forgets.
+ *
+ * What it measures, and what it leaves alone — see `newMemberBackgroundUrls`:
+ * only image backgrounds, only the customer's own (catalog artwork is measured
+ * at the sync), and only ones new to the design since it was last saved.
+ *
+ * **Fails open on infrastructure, closed on artwork.** The bytes live in
+ * Supabase Storage and the API never saw them at upload (the browser PUTs
+ * straight to a signed URL), so measuring means one HEAD-sized fetch of the
+ * header. If that fetch fails — storage down, a timeout — the save goes ahead
+ * with a warning in the log: the alternative is that a storage blip stops
+ * every customer saving every design, and the editor's own pre-upload check
+ * has already had its say. A file that *is* measured and is wrong is refused.
+ */
+@Injectable()
+export class ArtworkGateService {
+  private readonly logger = new Logger(ArtworkGateService.name);
+  private readonly cache = new Map<string, Promise<PixelSize | null>>();
+  private readonly allowedHosts: string[];
+
+  constructor(
+    config: ConfigService<EnvConfig, true>,
+    @Optional() @Inject(ARTWORK_GATE_FETCH) private readonly fetchImpl?: FetchLike,
+  ) {
+    const host = hostOf(config.get("SUPABASE_URL", { infer: true }));
+    this.allowedHosts = host ? [host] : [];
+  }
+
+  /**
+   * Refuse `document` if a background the customer has just added is not fit
+   * to print. `previous` is the design's stored document on an update, so a
+   * background it already carried is not re-judged.
+   */
+  async assertBackgroundsPrintable(
+    document: DesignDocument,
+    previous?: DesignDocument | null,
+  ): Promise<void> {
+    for (const url of newMemberBackgroundUrls(document, previous)) {
+      const natural = await this.measure(url);
+      if (natural === null) continue;
+      const verdict = backgroundArtworkVerdict(natural);
+      if (!verdict.ok) {
+        throw new BadRequestException(
+          `This background can't be printed as it is. ${verdict.message}`,
+        );
+      }
+    }
+  }
+
+  /**
+   * The size an image at `url` is seen at (EXIF orientation applied), or null
+   * when it could not be measured: not on our storage host, unreachable, or
+   * not an image sharp can read. Memoised per URL.
+   */
+  measure(url: string): Promise<PixelSize | null> {
+    const cached = this.cache.get(url);
+    if (cached) return cached;
+    const pending = this.measureUncached(url).catch((error: unknown) => {
+      this.logger.warn(`Could not measure background artwork (${url}): ${String(error)}`);
+      return null;
+    });
+    if (this.cache.size >= CACHE_LIMIT) {
+      const oldest = this.cache.keys().next().value;
+      if (oldest !== undefined) this.cache.delete(oldest);
+    }
+    this.cache.set(url, pending);
+    return pending;
+  }
+
+  private async measureUncached(url: string): Promise<PixelSize | null> {
+    // Same allowlist discipline as the print engine: a design document is
+    // customer-supplied and this runs server-side, so an unlisted host is an
+    // SSRF vector, not a measurement to make. A member background elsewhere
+    // is already a print problem (the engine will not fetch it either) and is
+    // reported as such by the print pre-flight, not here.
+    if (!isHostAllowed(url, this.allowedHosts)) {
+      this.logger.warn(`Background artwork not on the storage host, left unmeasured: ${url}`);
+      return null;
+    }
+    const fetched = await fetchAssetBytes(url, {
+      fetchImpl: this.fetchImpl,
+      maxBytes: MAX_ARTWORK_BYTES,
+      timeoutMs: FETCH_TIMEOUT_MS,
+      onWarn: (message) => this.logger.warn(message),
+    });
+    if (!fetched) return null;
+    // `metadata()` reads the header only — no decode. `orientation` is the EXIF
+    // tag, which the browser and pdfkit both honour and the header size ignores.
+    const { width, height, orientation } = await sharp(fetched.buffer).metadata();
+    if (!width || !height) return null;
+    return orientedPixelSize({ width, height, orientation });
+  }
+}
