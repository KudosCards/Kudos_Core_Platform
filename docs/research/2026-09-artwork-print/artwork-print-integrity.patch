+              />
+              <span className="text-sm text-muted">mm per long edge</span>
+              <button
+                type="button"
+                onClick={saveExtension}
+                disabled={busy || Number(extension) === profile.borderlessExtensionMm}
+                className="rounded-full border border-border px-3 py-1 text-sm disabled:opacity-50"
+              >
+                Save
+              </button>
+            </div>
+            <p className="text-xs text-muted">
+              Read this off the calibration print: how many millimetres the printer’s borderless
+              mode pushes past each long edge of the sheet. With it set, the PDF draws each card
