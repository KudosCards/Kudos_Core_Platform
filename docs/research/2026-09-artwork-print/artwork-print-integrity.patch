+                role="group"
+                aria-label="Back footer"
+              >
+                {BACK_FOOTER_MODES.map((option) => (
+                  <button
+                    key={option}
+                    type="button"
+                    onClick={() => save({ ...profile, backFooter: option })}
+                    disabled={busy}
+                    aria-pressed={profile.backFooter === option}
+                    className={`${toggle} ${profile.backFooter === option ? on : off}`}
+                  >
+                    {BACK_FOOTER_LABELS[option]}
+                  </button>
+                ))}
+              </div>
+            </div>
+            <div className="flex flex-wrap items-center gap-3">
+              <label htmlFor="borderless-extension" className="w-28 text-sm text-foreground">
+                Borderless overhang
