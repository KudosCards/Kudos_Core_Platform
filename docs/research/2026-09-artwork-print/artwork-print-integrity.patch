+import { BadRequestException } from "@nestjs/common";
+import type { ConfigService } from "@nestjs/config";
+import sharp from "sharp";
+import type { DesignDocument } from "@kudos/shared-types";
+import type { FetchLike } from "../print-pdf";
+import { ArtworkGateService } from "./artwork-gate.service";
+
+const STORAGE = "https://proj.supabase.co/storage/v1/object/public/design-assets";
+const MEMBER = `${STORAGE}/acct-1/`;
+const CATALOG = `${STORAGE}/catalog/`;
+
+/** A PNG of exactly this size, as the browser would have uploaded it. */
+async function png(width: number, height: number): Promise<Buffer> {
+  return sharp({ create: { width, height, channels: 3, background: "#fff" } })
+    .png()
+    .toBuffer();
+}
+
+/** A JPEG stored `width × height` with an EXIF tag saying "rotate 90°" — a
+ * phone photo. Every viewer shows it as height × width. */
+async function rotatedJpeg(width: number, height: number): Promise<Buffer> {
+  return sharp({ create: { width, height, channels: 3, background: "#fff" } })
+    .jpeg()
+    .withMetadata({ orientation: 6 })
+    .toBuffer();
+}
+
+function fetchFixtures(files: Record<string, Buffer>): { fetch: FetchLike; calls: string[] } {
+  const calls: string[] = [];
+  const fetch: FetchLike = (url) => {
+    calls.push(url);
+    const body = files[url];
+    return Promise.resolve({
+      ok: body !== undefined,
+      status: body ? 200 : 404,
+      headers: { get: () => null },
+      arrayBuffer: () =>
+        body
+          ? Promise.resolve(
+              body.buffer.slice(body.byteOffset, body.byteOffset + body.byteLength) as ArrayBuffer,
+            )
+          : Promise.reject(new Error("no body")),
+    });
+  };
+  return { fetch, calls };
+}
+
+function gate(fetch: FetchLike): ArtworkGateService {
+  const config = {
+    get: () => "https://proj.supabase.co",
+  } as unknown as ConfigService<never, true>;
+  return new ArtworkGateService(config, fetch);
+}
+
+function doc(front?: string, back?: string): DesignDocument {
+  return {
+    version: 1,
+    pages: [
+      {
+        name: "front",
+        elements: [],
+        ...(front ? { background: { type: "image", assetUrl: front } } : {}),
+      },
+      { name: "inside-left", elements: [] },
+      { name: "inside-right", elements: [] },
+      {
+        name: "back",
+        elements: [],
+        ...(back ? { background: { type: "image", assetUrl: back } } : {}),
+      },
+    ],
+  };
+}
+
+describe("ArtworkGateService", () => {
+  it("lets a background of the card's shape at print resolution through", async () => {
+    const url = `${MEMBER}good.png`;
+    const { fetch } = fetchFixtures({ [url]: await png(1240, 1748) });
+    await expect(gate(fetch).assertBackgroundsPrintable(doc(url))).resolves.toBeUndefined();
+  });
+
+  it("refuses the 2:3 shape that cropped the catalog, with the re-export size in the message", async () => {
+    const url = `${MEMBER}two-three.png`;
+    const { fetch } = fetchFixtures({ [url]: await png(1000, 1500) });
+    const attempt = gate(fetch).assertBackgroundsPrintable(doc(url));
+    await expect(attempt).rejects.toBeInstanceOf(BadRequestException);
+    await expect(attempt).rejects.toThrow(/6% of its height/);
+    await expect(attempt).rejects.toThrow(/1240 × 1748/);
+  });
+
+  it("refuses the right shape with too few pixels", async () => {
+    const url = `${MEMBER}small.png`;
+    const { fetch } = fetchFixtures({ [url]: await png(620, 874) });
+    await expect(gate(fetch).assertBackgroundsPrintable(doc(url))).rejects.toThrow(/dpi/);
+  });
+
+  it("reads EXIF orientation, so a rotated phone photo of the right shape is accepted", async () => {
+    // Stored 1748 × 1240 (landscape) with "rotate 90°": seen as 1240 × 1748.
+    const url = `${MEMBER}phone.jpg`;
+    const { fetch } = fetchFixtures({ [url]: await rotatedJpeg(1748, 1240) });
+    await expect(gate(fetch).assertBackgroundsPrintable(doc(url))).resolves.toBeUndefined();
+  });
+
+  it("does not measure catalog artwork — the sync's gate owns that", async () => {
+    const url = `${CATALOG}ours.png`;
+    const { fetch, calls } = fetchFixtures({ [url]: await png(1000, 1500) });
+    await expect(gate(fetch).assertBackgroundsPrintable(doc(url))).resolves.toBeUndefined();
+    expect(calls).toEqual([]);
+  });
+
+  it("does not re-judge a background the design already carried", async () => {
+    // A legacy design with a 2:3 member background: a text edit must still save.
+    const url = `${MEMBER}legacy.png`;
+    const { fetch, calls } = fetchFixtures({ [url]: await png(1000, 1500) });
+    await expect(
+      gate(fetch).assertBackgroundsPrintable(doc(url), doc(url)),
+    ).resolves.toBeUndefined();
+    expect(calls).toEqual([]);
+  });
+
+  it("judges a background that is new to the design even when another is not", async () => {
+    const kept = `${MEMBER}kept.png`;
+    const added = `${MEMBER}added.png`;
+    const { fetch, calls } = fetchFixtures({
+      [kept]: await png(1000, 1500),
+      [added]: await png(2000, 2000),
+    });
+    await expect(
+      gate(fetch).assertBackgroundsPrintable(doc(kept, added), doc(kept)),
+    ).rejects.toThrow(/29% of its width/);
+    expect(calls).toEqual([added]);
+  });
+
+  it("never fetches a host that is not our storage (SSRF), and lets the save through", async () => {
+    const url = "http://169.254.169.254/latest/meta-data/";
+    const { fetch, calls } = fetchFixtures({});
+    await expect(gate(fetch).assertBackgroundsPrintable(doc(url))).resolves.toBeUndefined();
+    expect(calls).toEqual([]);
+  });
+
+  it("fails open when storage cannot be reached, rather than blocking every save", async () => {
+    const url = `${MEMBER}missing.png`;
+    const { fetch } = fetchFixtures({});
+    await expect(gate(fetch).assertBackgroundsPrintable(doc(url))).resolves.toBeUndefined();
+  });
+
+  it("fails open on bytes that are not an image", async () => {
+    const url = `${MEMBER}not-an-image.png`;
+    const { fetch } = fetchFixtures({ [url]: Buffer.from("definitely not a png") });
+    await expect(gate(fetch).assertBackgroundsPrintable(doc(url))).resolves.toBeUndefined();
+  });
+
+  it("measures each URL once", async () => {
+    const url = `${MEMBER}once.png`;
+    const { fetch, calls } = fetchFixtures({ [url]: await png(1240, 1748) });
+    const service = gate(fetch);
+    await service.assertBackgroundsPrintable(doc(url));
+    await service.assertBackgroundsPrintable(doc(url, url));
+    expect(calls).toEqual([url]);
+  });
+});
