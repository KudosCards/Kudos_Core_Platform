+      <SuperAdminEditable>
+        {profile === null ? (
+          <p className="text-sm text-muted">Loading…</p>
+        ) : (
+          <div className="flex flex-col gap-4">
+            <div className="flex flex-wrap items-center gap-3">
+              <span className="w-28 text-sm text-foreground">Layout</span>
