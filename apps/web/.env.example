# Public (browser-visible) configuration. See apps/web/src/lib/env.ts.
NEXT_PUBLIC_API_URL="http://localhost:3001"
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Canonical public origin, used for auth-email redirects. Optional.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# GA4 measurement id. Deliberately blank here and unset in development: it is
# supplied only for Netlify's production context (netlify.toml), so local work
# and deploy previews send nothing to the live analytics property.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Server-only. Shared secret the API sends to POST /api/revalidate-catalog when
# a catalog sync finishes, so the public card library publishes straight away
# rather than waiting out its hourly cache. Must match CATALOG_REVALIDATE_SECRET
# on the API. Deliberately not NEXT_PUBLIC_*: it must never reach the browser.
# Unset ⇒ the endpoint answers 503 and the catalog falls back to the timer.
CATALOG_REVALIDATE_SECRET=
