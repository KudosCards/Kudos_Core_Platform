// Kudos Cards platform — primary schema.
//
// Enum values here are the source of truth alongside packages/shared-types/src/enums.ts.
// Prisma can't import from TS, so any enum change must be made in both places in the
// same commit — see docs/adr/0001-stack-choice.md for why we accept that duplication.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Tenancy
// ---------------------------------------------------------------------------

enum AccountType {
  organisation
  individual
}

enum MembershipRole {
  owner
  admin
  staff
}

model Account {
  id                    String      @id @default(uuid())
  type                  AccountType
  name                  String
  stripeCustomerId      String?     @unique @map("stripe_customer_id")
  planId                String?     @map("plan_id")
  /// Guest one-off buyer's email — captured at Stripe checkout for the receipt
  /// and the account-claim link. Null for accounts created via normal signup
  /// (identity comes from the membership's user). See docs/adr/0025.
  contactEmail          String?     @map("contact_email")
  /// Single-use token that lets a guest claim (attach a login to) the account
  /// they just bought from. Set when a guest order is created, nulled on claim
  /// or expiry. A secret — never returned by the API (findById omits it).
  claimToken            String?     @unique @map("claim_token")
  claimTokenExpiresAt   DateTime?   @map("claim_token_expires_at")
  /// Whether we email this account upcoming-birthday reminders. Opt-out (default
  /// on); the reminder cron skips accounts with this false. See docs/adr/0025.
  reminderEmailsEnabled Boolean     @default(true) @map("reminder_emails_enabled")
  /// Paid team seats beyond the plan's included allowance (Centre includes 3).
  /// The seat limit = PlanEntitlement.includedSeats + extraSeats; inviting past
  /// it is hard-blocked until a seat is added. Kept in sync with the Stripe
  /// subscription's per-seat item quantity. See docs/adr/0035-seat-based-billing.md.
  extraSeats            Int         @default(0) @map("extra_seats")
  createdAt             DateTime    @default(now()) @map("created_at")
  updatedAt             DateTime    @updatedAt @map("updated_at")

  memberships          Membership[]
  invites              Invite[]
  recipients           Recipient[]
  savedDesigns         SavedDesign[]
  batchOrders          BatchOrder[]
  walletEntries        WalletLedgerEntry[]
  subscriptions        Subscription[]
  subscriptionInvoices SubscriptionInvoice[]
  auditLogs            AuditLogEntry[]
  apiKeys              AccountApiKey[]
  crmConnections       CrmConnection[]
  recipientLists       RecipientList[]
  segments             Segment[]
  notifications        Notification[]
  returnCases          ReturnCase[]
  events               Event[]
  supportTickets       SupportTicket[]
  designAssets         DesignAsset[]
  messagePages         MessagePage[]

  // Super-admin subscribers list is ordered newest-first.
  @@index([createdAt])
  @@map("accounts")
}

/// A persisted, per-user record of something that already happened in the
/// account and is worth telling a member about after the fact — an order paid,
/// an auto-send fired, a colleague joined. This is deliberately distinct from
/// the *computed* notification feed (notifications.service.ts, ADR 0030), which
/// derives live "action needed" items from current state and carries no
/// read/unread. An account-wide event fans out one row per active member, so
/// read state (readAt) is per-user. entityType/entityId let a producer stay
/// idempotent under retries (skip if a row for this kind+entity already exists).
/// userId is the Supabase Auth user id — not a Prisma FK, same as Membership.
/// See docs/adr/0034-notification-inbox.md.
model Notification {
  id         String    @id @default(uuid())
  accountId  String    @map("account_id")
  userId     String    @map("user_id")
  kind       String
  title      String
  body       String
  href       String?
  entityType String?   @map("entity_type")
  entityId   String?   @map("entity_id")
  readAt     DateTime? @map("read_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  // The unread badge + the member's inbox list, both newest-first per user.
  @@index([userId, createdAt])
  // Idempotency lookup: has this account already been notified about this event?
  @@index([accountId, kind, entityId])
  @@map("notifications")
}

/// A customer's connection to an external CRM (Brevo, …) that recipients are
/// synced *from*. The CRM API key is stored AES-256-GCM encrypted (see
/// common/crypto.service.ts) — never in plaintext. One connection per provider
/// per account. See docs/adr/0015-crm-integrations.md.
model CrmConnection {
  id        String @id @default(uuid())
  accountId String @map("account_id")
  /// The CRM: "brevo" (API key) or "hubspot" (OAuth) today; more later.
  provider  String
  /// How this connection authenticates: "api_key" (Brevo) or "oauth" (HubSpot).
  authType  String @default("api_key") @map("auth_type")

  /// AES-256-GCM-encrypted API key — set for api_key providers (Brevo), null for OAuth.
  encryptedApiKey String? @map("encrypted_api_key")

  /// OAuth credentials — set for oauth providers (HubSpot), null for api_key.
  /// Both tokens are AES-256-GCM-encrypted at rest, never stored in plaintext.
  encryptedAccessToken  String?   @map("encrypted_access_token")
  encryptedRefreshToken String?   @map("encrypted_refresh_token")
  /// When the access token expires — refreshed just-in-time before a sync.
  tokenExpiresAt        DateTime? @map("token_expires_at")
  /// The account's id in the provider (e.g. HubSpot hub/portal id) — display only.
  externalAccountId     String?   @map("external_account_id")

  /// Optional per-connection field mapping (CRM attribute name → our field).
  fieldMapping   Json?     @map("field_mapping")
  syncEnabled    Boolean   @default(true) @map("sync_enabled")
  lastSyncedAt   DateTime? @map("last_synced_at")
  lastSyncStatus String?   @map("last_sync_status")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, provider])
  @@map("crm_connections")
}

/// A per-account API key for the inbound integrations endpoint (push contacts
/// into Recipients). Only the SHA-256 hash is stored — the plaintext key is
/// shown to the customer exactly once, at creation. See ADR 0015.
model AccountApiKey {
  id         String    @id @default(uuid())
  accountId  String    @map("account_id")
  label      String
  keyHash    String    @unique @map("key_hash")
  /// A short non-secret prefix (e.g. "kudos_ab12cd…") for display in the UI.
  prefix     String
  lastUsedAt DateTime? @map("last_used_at")
  revokedAt  DateTime? @map("revoked_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@map("account_api_keys")
}

/// A reusable image a member uploaded in the card designer, so a logo/photo can
/// be placed again without re-uploading (the "Your uploads" library). One row
/// per completed upload; `url` is the bucket's public URL that design documents
/// reference. Deleting a row only removes it from the library — the storage
/// object is intentionally left in place because existing designs may still
/// reference the same url. See docs/adr/0070-saved-assets-library.md.
model DesignAsset {
  id        String   @id @default(uuid())
  accountId String   @map("account_id")
  url       String
  fileName  String   @map("file_name")
  /// Natural pixel dimensions, captured at upload so the picker can insert the
  /// image at its true aspect ratio. Nullable for assets recorded without them.
  width     Int?
  height    Int?
  createdAt DateTime @default(now()) @map("created_at")

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, createdAt])
  @@map("design_assets")
}

/// userId references the Supabase Auth user (managed outside Prisma's schema),
/// so it is intentionally not a Prisma foreign key — just an indexed UUID.
model Membership {
  id        String         @id @default(uuid())
  accountId String         @map("account_id")
  userId    String         @map("user_id")
  role      MembershipRole
  /// The member's email, captured when the membership is created (from the
  /// signing-up user for the owner, from the invite for invited members) so the
  /// team-management UI can show who's who. Nullable for legacy rows. See ADR 0028.
  email     String?
  createdAt DateTime       @default(now()) @map("created_at")

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, userId])
  @@index([userId])
  @@map("memberships")
}

enum InviteStatus {
  pending
  accepted
  revoked
}

/// A pending invitation for someone to join an account's team. Gated to plans
/// with teamSeatsEnabled (Centre). The `token` is a secret — whoever holds it
/// can join the account as the invited role — so it is never returned by the
/// API (only emailed to the invitee). See docs/adr/0028-multi-user-teams.md.
model Invite {
  id              String         @id @default(uuid())
  accountId       String         @map("account_id")
  /// Invitee email, lowercased. The accepting user's verified JWT email must
  /// match this, so a forwarded link can't be redeemed by someone else.
  email           String
  role            MembershipRole
  token           String         @unique
  status          InviteStatus   @default(pending)
  invitedByUserId String?        @map("invited_by_user_id")
  expiresAt       DateTime       @map("expires_at")
  acceptedAt      DateTime?      @map("accepted_at")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  // One live invite per email per account — re-inviting replaces the old row.
  @@unique([accountId, email])
  @@index([accountId])
  @@map("invites")
}

// ---------------------------------------------------------------------------
// CRM
// ---------------------------------------------------------------------------

enum RecipientStatus {
  active
  lapsed
  archived
}

model Recipient {
  id                          String          @id @default(uuid())
  accountId                   String          @map("account_id")
  firstName                   String          @map("first_name")
  lastName                    String          @map("last_name")
  /// Nullable: not every occasion needs a DOB on file.
  dateOfBirth                 DateTime?       @map("date_of_birth") @db.Date
  email                       String?
  addressLine1                String?         @map("address_line1")
  addressLine2                String?         @map("address_line2")
  addressCity                 String?         @map("address_city")
  addressPostcode             String?         @map("address_postcode")
  addressCountry              String?         @default("GB") @map("address_country")
  tags                        String[]        @default([])
  /// Arbitrary per-recipient key→value fields, usable as {key} merge tokens on
  /// a card (e.g. {teacher}, {class}). See docs/adr/0033-richer-merge-tokens.md.
  customFields                Json?           @map("custom_fields")
  status                      RecipientStatus @default(active)
  /// True once a card to this contact was Returned to Sender (RTS) and the
  /// address hasn't been re-verified. While set: automatic/scheduled sends to
  /// this contact are paused, and manual checkout shows a warning. Cleared when
  /// the open return case is resolved (address updated + recovery chosen) or
  /// archived. See docs/adr/0039-returned-to-sender.md.
  addressVerificationRequired Boolean         @default(false) @map("address_verification_required")
  /// Where this recipient came from: "manual", "csv", "api", or a CRM id
  /// ("brevo", "hubspot", …). See docs/adr/0015-crm-integrations.md.
  source                      String          @default("manual")
  /// The stable id of this contact in its source system (a CRM record id, or
  /// the caller's own id for the inbound API). Null for manual/CSV recipients.
  externalId                  String?         @map("external_id")
  createdAt                   DateTime        @default(now()) @map("created_at")
  updatedAt                   DateTime        @updatedAt @map("updated_at")

  account         Account                   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  occasions       Occasion[]
  orderRecipients OrderRecipient[]
  listMemberships RecipientListMembership[]
  returnCases     ReturnCase[]
  keyDates        RecipientKeyDate[]

  // Mirrors the legacy CSV-import dedupe rule: same name + postcode + DOB = same person.
  @@unique([accountId, firstName, lastName, addressPostcode, dateOfBirth], name: "recipient_dedupe_key")
  // Source-based identity for integrations: re-syncing a CRM contact updates
  // the same row instead of duplicating. externalId is null for manual/CSV
  // recipients, and Postgres treats NULLs as distinct, so they never collide.
  @@unique([accountId, source, externalId], name: "recipient_source_key")
  @@index([accountId, status])
  // The recipients list: `where accountId order by createdAt desc` (+ paginate).
  // Without this, Postgres filters by account then sorts every time. See ADR 0046.
  @@index([accountId, createdAt])
  @@map("recipients")
}

/// A recurring "key date" for a recipient — a renewal or anniversary anchored on
/// a month/day, from which the scheduler materialises a dated occasion each year
/// (exactly like a birthday from the date of birth). One per type per recipient.
/// See docs/adr/0104-recurring-key-dates.md.
model RecipientKeyDate {
  id          String      @id @default(uuid())
  accountId   String      @map("account_id")
  recipientId String      @map("recipient_id")
  type        KeyDateType
  /// The anchor date; the occasion recurs annually on this month/day.
  date        DateTime    @db.Date
  /// Optional human label shown on the occasion/calendar (e.g. "Membership renewal").
  label       String?
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  recipient Recipient @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  // One renewal date + one anniversary date per recipient.
  @@unique([recipientId, type], name: "recipient_key_date_type")
  @@index([accountId])
  @@map("recipient_key_dates")
}

/// A saved "smart list" — a named, live-resolving filter over the contact book.
/// Unlike RecipientList (frozen hand-picked membership), a Segment stores only a
/// filter definition and resolves to its members on demand: occasion-mode
/// ("birthdays this month") or contact-mode ("missing an address"). System
/// presets are code-defined; these are the user's own. See
/// docs/adr/0105-segments-smart-lists.md.
model Segment {
  id         String   @id @default(uuid())
  accountId  String   @map("account_id")
  name       String
  /// The SegmentDefinition (shared-types) — occasion/contact filter, as JSON.
  definition Json
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, name], name: "segment_name_key")
  @@index([accountId, createdAt])
  @@map("segments")
}

/// A named grouping of recipients a subscriber curates by hand — e.g. a teacher's
/// "Year 4 class", "Year 5 class". Purely organisational: lists help filter and
/// personalise cards in bulk; they don't drive occasions or billing on their own.
/// See docs/adr/0016-recipient-events-and-lists.md.
model RecipientList {
  id        String   @id @default(uuid())
  accountId String   @map("account_id")
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  account Account                   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  members RecipientListMembership[]

  // A list name is unique within an account so "Year 4 class" can't be created twice.
  @@unique([accountId, name], name: "recipient_list_name_key")
  @@index([accountId])
  @@map("recipient_lists")
}

/// Join row: a recipient's membership in a list (many-to-many). Cascade-deletes
/// with either side, so archiving a list or a recipient tidies the membership up.
model RecipientListMembership {
  listId      String   @map("list_id")
  recipientId String   @map("recipient_id")
  createdAt   DateTime @default(now()) @map("created_at")

  list      RecipientList @relation(fields: [listId], references: [id], onDelete: Cascade)
  recipient Recipient     @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  @@id([listId, recipientId])
  @@index([recipientId])
  @@map("recipient_list_memberships")
}

// ---------------------------------------------------------------------------
// Occasions & scheduling
// ---------------------------------------------------------------------------

enum OccasionType {
  birthday
  renewal
  anniversary
  achievement
  leaver
  staff_recognition
  seasonal
  bespoke_campaign
}

/// The recurring key-date types anchored per recipient (birthdays come from
/// Recipient.dateOfBirth instead). Drives auto-generated renewal/anniversary
/// occasions. See docs/adr/0104-recurring-key-dates.md.
enum KeyDateType {
  renewal
  anniversary
}

enum OccasionSource {
  recurring_per_recipient
  one_off_campaign
  /// A member of a shared Event — one card, the same design, sent to a curated
  /// cohort of contacts (End of Year, Results Day, …). Grouped on the calendar
  /// by the parent Event. See docs/adr/0057-shared-events.md.
  shared_event
}

enum OccasionStatus {
  scheduled
  pending_approval
  approved
  queued
  printed
  posted
  delivered
  skipped
}

model Occasion {
  id                     String         @id @default(uuid())
  accountId              String         @map("account_id")
  /// Null for one_off_campaign occasions (e.g. an org-wide "Student of the Month" send).
  recipientId            String?        @map("recipient_id")
  type                   OccasionType
  source                 OccasionSource
  /// Optional human label for a hand-added recipient event ("Graduation", "End
  /// of exams") — lets the calendar show the real name rather than just the
  /// broad `type`. Null for auto-scheduled birthdays and campaign occasions.
  title                  String?
  occasionDate           DateTime       @map("occasion_date") @db.Date
  dispatchDate           DateTime?      @map("dispatch_date") @db.Date
  /// True when a human manually placed the dispatch date (dragged it on the
  /// calendar), so the working-day recompute doesn't silently undo it. Cleared
  /// when the occasion date changes (the timing baseline moved). See
  /// docs/adr/0058-drag-dispatch.md.
  dispatchDateOverridden Boolean        @default(false) @map("dispatch_date_overridden")
  status                 OccasionStatus @default(scheduled)
  /// How this occasion is sent once approved. `asap` (default) means a human
  /// checks it out manually; `auto_send` means the auto-send cron creates the
  /// order, pays it from the wallet, and posts it timed to the dispatchDate —
  /// no manual checkout. See docs/adr/0013-auto-send.md.
  dispatchOption         DispatchOption @default(asap) @map("dispatch_option")
  /// Postage class chosen at approval for auto_send occasions; drives both the
  /// stamp cost and the dispatchDate lead time. Ignored for `asap` occasions
  /// (postage is chosen per line at manual checkout).
  postageClass           PostageClass   @default(second_class) @map("postage_class")
  /// Set when an admin approves the occasion (see docs/adr/0006-phase-2-scope.md). Copied
  /// into OrderRecipient.savedDesignId by Phase 3's checkout flow — the design choice
  /// travels with the occasion instead of being re-selected at checkout.
  savedDesignId          String?        @map("saved_design_id")
  /// When a birthday-reminder email covering this occasion was sent, so the
  /// daily reminder cron never emails the same upcoming occasion twice. Null
  /// until reminded. See docs/adr/0025.
  reminderSentAt         DateTime?      @map("reminder_sent_at")
  /// Set when this occasion is one member of a shared Event (source =
  /// shared_event). The parent Event owns the title, date, and type; the
  /// calendar groups all members under one collapsible entry. Null for
  /// standalone occasions. See docs/adr/0057-shared-events.md.
  eventId                String?        @map("event_id")
  /// Set on a one_off_campaign occasion created by a "send to segment" bulk send:
  /// points at the recipient's natural occasion (e.g. their birthday this month)
  /// that this send stands in for. At payment settlement the referenced occasion
  /// is marked `skipped` so it can't independently fire and double-send. Null for
  /// every other occasion. See docs/adr/0107-occasion-reconciliation.md.
  supersedesOccasionId   String?        @map("supersedes_occasion_id")
  createdAt              DateTime       @default(now()) @map("created_at")
  updatedAt              DateTime       @updatedAt @map("updated_at")

  recipient       Recipient?       @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  // Restrict, not the nullable-relation default of SetNull — an approved occasion
  // silently losing its design would be a worse state than blocking the delete.
  savedDesign     SavedDesign?     @relation(fields: [savedDesignId], references: [id], onDelete: Restrict)
  // Deleting the parent Event removes its still-scheduled member occasions.
  event           Event?           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  orderRecipients OrderRecipient[]
  // Self-relation: a campaign occasion supersedes the natural occasion it replaces.
  // SetNull, not Cascade — deleting the campaign occasion must never delete the
  // real birthday/renewal it stood in for.
  supersedes      Occasion?        @relation("OccasionSupersedes", fields: [supersedesOccasionId], references: [id], onDelete: SetNull)
  supersededBy    Occasion[]       @relation("OccasionSupersedes")

  // Prevents the scheduler from double-creating the same occasion instance on retry.
  @@unique([recipientId, type, occasionDate], name: "occasion_idempotency_key")
  @@index([accountId, status])
  @@index([dispatchDate])
  // The calendar: `where accountId and occasionDate between from..to order by
  // occasionDate` — an account-scoped range scan in sorted order. See ADR 0046.
  @@index([accountId, occasionDate])
  // Fetch/group all member occasions of an event.
  @@index([eventId])
  @@map("occasions")
}

/// A shared event: one card design sent to a curated cohort of contacts on the
/// same date (End of Year, Results Day, SATs, a Christmas send). The Event owns
/// the human title, type, and date; each attached contact is a member Occasion
/// (source = shared_event) so the whole existing pipeline — calendar, approvals,
/// checkout, auto-send, order links — works unchanged, while the calendar
/// collapses the members into one entry. See docs/adr/0057-shared-events.md.
model Event {
  id        String       @id @default(uuid())
  accountId String       @map("account_id")
  /// Human title shown on the calendar and cards ("End of Year 2026").
  title     String
  /// Broad category, reused from occasions for calendar colour + filtering.
  type      OccasionType
  /// The date the event falls on; every member occasion inherits it.
  eventDate DateTime     @map("event_date") @db.Date
  /// Optional free-text note for the organiser (not printed).
  notes     String?
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  account   Account    @relation(fields: [accountId], references: [id], onDelete: Cascade)
  occasions Occasion[]

  // The calendar range scan, account-scoped and date-ordered.
  @@index([accountId, eventDate])
  @@map("events")
}

// ---------------------------------------------------------------------------
// Card designer
// ---------------------------------------------------------------------------

model CardDesign {
  id           String   @id @default(uuid())
  category     String
  name         String
  /// URL slug for the public catalog — `/cards/<category>/<slug>`. Assigned once
  /// (from the name) and never recomputed: a slug that tracked the name would
  /// break indexed URLs and the QR codes on cards already posted the moment a
  /// title was corrected. See docs/adr/0163-catalog-urls-and-category-pages.md.
  slug         String   @unique
  thumbnailUrl String   @map("thumbnail_url")
  /// DesignDocument JSON — see packages/shared-types/src/card.ts for the shape.
  document     Json
  isActive     Boolean  @default(true) @map("is_active")
  /// The Airtable record id this design was synced from (null for seeded
  /// templates). Unique so the catalog sync can upsert in place — see
  /// docs/adr/0011-airtable-catalog-sync.md.
  externalId   String?  @unique @map("external_id")
  /// Human-facing product code from Airtable (e.g. "KC-BDAY-GEN-001"), shown
  /// to the ops team. Null for seeded templates.
  sku          String?  @map("sku")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  savedDesigns SavedDesign[]

  @@index([category, isActive])
  @@map("card_designs")
}

/// A personalised instance of a CardDesign, saved to an account's "My Designs".
model SavedDesign {
  id           String    @id @default(uuid())
  accountId    String    @map("account_id")
  /// Null for a member's own uploaded artwork, which starts from a blank
  /// document rather than a catalog template. See docs/adr/0026.
  cardDesignId String?   @map("card_design_id")
  name         String
  document     Json
  /// Soft-delete marker. A design used by a past order (OrderRecipient) or an
  /// approved occasion can't be hard-deleted without breaking that immutable
  /// history — deleting it archives it out of the library instead. The gallery
  /// lists only rows where this is null. See docs/adr/0158-design-archive.md.
  archivedAt   DateTime? @map("archived_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  account         Account          @relation(fields: [accountId], references: [id], onDelete: Cascade)
  // SetNull (Prisma's default for an optional relation, now explicit): a saved
  // design carries its own full `document`, so it survives fine if the origin
  // catalog template is removed — the link just clears. Deliberately unlike the
  // Occasion→SavedDesign relation, which is Restrict because an occasion without
  // its design is a broken state. This makes explicit what the schema always
  // implied; the init migration created the FK as RESTRICT, so a migration
  // reconciles the DB. See docs/adr/0048-saved-designs-fk.md.
  cardDesign      CardDesign?      @relation(fields: [cardDesignId], references: [id], onDelete: SetNull)
  orderRecipients OrderRecipient[]
  occasions       Occasion[]

  @@index([accountId])
  @@map("saved_designs")
}

// ---------------------------------------------------------------------------
// Batch ordering
// ---------------------------------------------------------------------------

enum BatchOrderStatus {
  draft
  pending_payment
  paid
  fulfilling
  completed
  cancelled
}

enum PaymentMethod {
  card
  wallet
}

/// One order representing a whole batch (e.g. "10 birthday cards this week").
/// Deliberately one order with many recipient lines, not one cart line per
/// recipient — see docs/adr/0002-batch-order-model.md.
model BatchOrder {
  id                    String           @id @default(uuid())
  /// Human-friendly sequential order number (rendered as ORD-1035). Separate
  /// from the uuid id so ops/customers have a short reference. Sequence starts
  /// at 1000 (see the migration) so the first orders read ORD-1000+.
  orderNumber           Int              @unique @default(autoincrement()) @map("order_number")
  accountId             String           @map("account_id")
  /// The user who placed the order. Null for guest one-off purchases, which are
  /// created by an unauthenticated visitor against a fresh guest account with no
  /// membership. See docs/adr/0025.
  createdByUserId       String?          @map("created_by_user_id")
  status                BatchOrderStatus @default(draft)
  currency              String           @default("GBP")
  subtotalMinor         Int              @default(0) @map("subtotal_minor")
  postageMinor          Int              @default(0) @map("postage_minor")
  totalMinor            Int              @default(0) @map("total_minor")
  paymentMethod         PaymentMethod?   @map("payment_method")
  /// How much of this order was paid from the account wallet, in pence. Reserved
  /// (debited) when the Checkout Session is created, not when payment settles —
  /// two concurrent checkouts sizing their charge against the same balance would
  /// otherwise overdraw it. Released back to the ledger on every path where the
  /// payment never completes. 0 means no wallet money was used; a *fully*
  /// wallet-paid order records that on `paymentMethod` instead. See ADR 0169.
  walletAppliedMinor    Int              @default(0) @map("wallet_applied_minor")
  stripePaymentIntentId String?          @unique @map("stripe_payment_intent_id")
  /// Stripe's generated VAT invoice for a card-paid order (Stripe is the source
  /// of truth for VAT/company details, exactly like subscriber invoices). Set
  /// from the invoice.paid webhook. Null for wallet-paid orders (no Stripe charge
  /// of their own). See docs/adr/0102-vat-receipts.md.
  stripeInvoiceId       String?          @unique @map("stripe_invoice_id")
  /// Stripe hosted invoice page (view online).
  receiptUrl            String?          @map("receipt_url")
  /// Stripe generated invoice PDF (the downloadable VAT receipt).
  receiptPdfUrl         String?          @map("receipt_pdf_url")
  createdAt             DateTime         @default(now()) @map("created_at")
  updatedAt             DateTime         @updatedAt @map("updated_at")

  account         Account          @relation(fields: [accountId], references: [id], onDelete: Cascade)
  orderRecipients OrderRecipient[]

  @@index([accountId, status])
  // Super-admin dashboard: status-filtered lists + status aggregates (ordered by
  // date), and the default "all non-draft, newest first" list.
  @@index([status, createdAt])
  @@index([createdAt])
  // The customer orders list: `where accountId order by createdAt desc` (+
  // paginate). The [accountId, status] index doesn't cover the createdAt sort.
  // See ADR 0046.
  @@index([accountId, createdAt])
  @@map("batch_orders")
}

enum DispatchOption {
  asap
  auto_send
}

enum PostageClass {
  first_class
  second_class
}

enum OrderRecipientStatus {
  pending_approval
  approved
  queued
  printed
  posted
  delivered
  returned_to_sender
  cancelled
}

/// One recipient's line within a BatchOrder. This is the fix for the legacy
/// system's N-identical-cart-lines checkout friction.
model OrderRecipient {
  id                      String               @id @default(uuid())
  batchOrderId            String               @map("batch_order_id")
  recipientId             String               @map("recipient_id")
  occasionId              String?              @map("occasion_id")
  savedDesignId           String               @map("saved_design_id")
  /// The library message page chosen for this card in the send flow (ADR 0132).
  /// When set, settlement mints this card's QR link onto that shared page
  /// (reuse); when null, a fresh per-card page is auto-created as before.
  messagePageId           String?              @map("message_page_id")
  shippingAddressLine1    String               @map("shipping_address_line1")
  shippingAddressLine2    String?              @map("shipping_address_line2")
  shippingAddressCity     String               @map("shipping_address_city")
  shippingAddressPostcode String               @map("shipping_address_postcode")
  shippingAddressCountry  String               @default("GB") @map("shipping_address_country")
  dispatchOption          DispatchOption
  postageClass            PostageClass
  /// Card price (VAT-inclusive, after the plan discount) for this one card.
  priceMinor              Int                  @map("price_minor")
  /// The stamp cost for this one card (per-card postage, VAT-exempt).
  postageMinor            Int                  @default(0) @map("postage_minor")
  status                  OrderRecipientStatus @default(pending_approval)
  createdAt               DateTime             @default(now()) @map("created_at")
  updatedAt               DateTime             @updatedAt @map("updated_at")

  batchOrder        BatchOrder       @relation(fields: [batchOrderId], references: [id], onDelete: Cascade)
  recipient         Recipient        @relation(fields: [recipientId], references: [id])
  occasion          Occasion?        @relation(fields: [occasionId], references: [id])
  savedDesign       SavedDesign      @relation(fields: [savedDesignId], references: [id])
  chosenMessagePage MessagePage?     @relation("ChosenMessagePage", fields: [messagePageId], references: [id], onDelete: SetNull)
  messagePageLink   MessagePageLink?
  fulfillmentJob    FulfillmentJob?
  returnCase        ReturnCase?

  @@index([batchOrderId])
  @@index([recipientId])
  @@map("order_recipients")
}

enum MessagePageStatus {
  active
  archived
}

enum MessagePageVideoType {
  none
  embed
  upload
}

enum MessagePageVideoProvider {
  youtube
  vimeo
  loom
  google_drive
}

/// Account-owned digital message page CONTENT — authored once, reusable across
/// many cards. The physical QR on each card is a MessagePageLink that points
/// here; a reusable page has many links, a bespoke page one. Split from the old
/// 1:1-with-OrderRecipient model so reuse + per-card analytics + standalone
/// authoring are all possible. See docs/adr/0132-message-pages-v2.md.
model MessagePage {
  id              String                    @id @default(uuid())
  accountId       String                    @map("account_id")
  createdByUserId String?                   @map("created_by_user_id")
  title           String
  message         String?
  emoji           String?
  videoType       MessagePageVideoType      @default(none) @map("video_type")
  videoUrl        String?                   @map("video_url")
  videoProvider   MessagePageVideoProvider? @map("video_provider")
  ctaLabel        String?                   @map("cta_label")
  ctaUrl          String?                   @map("cta_url")
  allowReplies    Boolean                   @default(false) @map("allow_replies")
  /// Manual greeting name for a standalone link (no order recipient to read it
  /// from). Ignored when a link is bound to an order recipient.
  recipientName   String?                   @map("recipient_name")
  status          MessagePageStatus         @default(active)
  createdAt       DateTime                  @default(now()) @map("created_at")
  updatedAt       DateTime                  @updatedAt @map("updated_at")

  account                 Account           @relation(fields: [accountId], references: [id], onDelete: Cascade)
  links                   MessagePageLink[]
  /// Order recipients that chose this page in the send flow (before settlement
  /// turns each choice into a per-card link). See docs/adr/0132-message-pages-v2.md.
  chosenByOrderRecipients OrderRecipient[]  @relation("ChosenMessagePage")

  @@index([accountId])
  @@map("message_pages")
}

/// One QR/slug — the scannable identity for a single physical card (or a
/// standalone/manual QR when orderRecipientId is null). Carries this card's own
/// engagement counters, so a shared page still yields per-recipient analytics.
model MessagePageLink {
  id               String    @id @default(uuid())
  slug             String    @unique
  messagePageId    String    @map("message_page_id")
  orderRecipientId String?   @unique @map("order_recipient_id")
  viewCount        Int       @default(0) @map("view_count")
  firstViewedAt    DateTime? @map("first_viewed_at")
  ctaClickCount    Int       @default(0) @map("cta_click_count")
  createdAt        DateTime  @default(now()) @map("created_at")

  messagePage    MessagePage        @relation(fields: [messagePageId], references: [id], onDelete: Cascade)
  orderRecipient OrderRecipient?    @relation(fields: [orderRecipientId], references: [id], onDelete: Cascade)
  replies        MessagePageReply[]
  events         MessagePageEvent[]

  @@index([messagePageId])
  @@map("message_page_links")
}

/// A recipient's written reply, posted from the public message page (Phase 2,
/// ADR 0132). Tied to the LINK, not the page, so a shared page still tells the
/// sender which card/recipient replied. Plain text, length-capped; read state
/// is account-level (the reply is handled or not).
model MessagePageReply {
  id                String    @id @default(uuid())
  messagePageLinkId String    @map("message_page_link_id")
  senderName        String?   @map("sender_name")
  body              String
  readAt            DateTime? @map("read_at")
  createdAt         DateTime  @default(now()) @map("created_at")

  messagePageLink MessagePageLink @relation(fields: [messagePageLinkId], references: [id], onDelete: Cascade)

  @@index([messagePageLinkId])
  @@map("message_page_replies")
}

enum MessagePageEventType {
  viewed
  cta_clicked
  replied
}

/// Append-only engagement event for time-series analytics (ADR 0136, Phase 2).
/// One row per public view / CTA click / reply. Deliberately PII-free — no IP,
/// user-agent, or free text — just which card, what kind, and when, so the
/// recipient-facing GDPR surface stays minimal. `accountId`/`messagePageId` are
/// DENORMALISED off the link so account- and page-level time-series never join
/// back through links. Written dark behind MESSAGE_EVENTS_ENABLED; pruned after
/// MESSAGE_EVENTS_RETENTION_DAYS. The lifetime counters on MessagePageLink
/// remain the source of truth for current-state totals.
model MessagePageEvent {
  id                String               @id @default(uuid())
  messagePageLinkId String               @map("message_page_link_id")
  messagePageId     String               @map("message_page_id")
  accountId         String               @map("account_id")
  type              MessagePageEventType
  createdAt         DateTime             @default(now()) @map("created_at")

  messagePageLink MessagePageLink @relation(fields: [messagePageLinkId], references: [id], onDelete: Cascade)

  @@index([accountId, createdAt])
  @@index([messagePageId, createdAt])
  @@index([createdAt])
  @@map("message_page_events")
}

// ---------------------------------------------------------------------------
// Billing — kept deliberately separate from BatchOrder/wallet billing so a
// plan is always a Stripe Subscription and a card batch is always a Stripe
// PaymentIntent or a wallet debit, never one conflated cart/subscription
// object (see docs/adr/0003-billing-separation.md).
// ---------------------------------------------------------------------------

enum SubscriptionStatus {
  trialing
  active
  past_due
  canceled
  incomplete
}

model Subscription {
  id                   String             @id @default(uuid())
  accountId            String             @map("account_id")
  planId               String             @map("plan_id")
  stripeSubscriptionId String             @unique @map("stripe_subscription_id")
  status               SubscriptionStatus
  currentPeriodEnd     DateTime           @map("current_period_end")
  // Timestamp (event.created) of the most recent Stripe subscription webhook we
  // applied to this row. Stripe redelivers at-least-once and does NOT guarantee
  // delivery order, so a stale/replayed event is dropped if it predates what
  // we've already applied — the guard that stops a late `updated (active)` from
  // resurrecting a subscription a later `deleted` already cancelled. See ADR 0153.
  lastEventAt          DateTime?          @map("last_event_at")
  createdAt            DateTime           @default(now()) @map("created_at")

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  // Super-admin overview counts active subscriptions across all accounts.
  @@index([status])
  @@map("subscriptions")
}

/// One paid Stripe **subscription** invoice, captured so we can answer "what has
/// this account paid us in subscriptions" — which `Subscription` cannot, since it
/// only holds current state (plan, status, period end) and no amounts at all.
///
/// Append-only and keyed on Stripe's invoice id, which is what makes capture
/// idempotent: Stripe redelivers `invoice.paid` at-least-once, and the same id
/// is also what a historical backfill reads, so a backfill running alongside
/// live webhooks converges instead of double-counting.
///
/// Card-order invoices are deliberately NOT stored here — those already attach
/// their receipt to the BatchOrder (ADR 0102). This table is subscription income
/// only, so summing it can't silently double-count card revenue.
model SubscriptionInvoice {
  id                   String    @id @default(uuid())
  accountId            String    @map("account_id")
  /// Stripe's invoice id. Unique — the idempotency key for webhook + backfill.
  stripeInvoiceId      String    @unique @map("stripe_invoice_id")
  /// The subscription this invoice billed, when Stripe tells us.
  stripeSubscriptionId String?   @map("stripe_subscription_id")
  /// Gross amount the customer actually paid, in minor units. Stripe's
  /// `amount_paid`, not `total` — a partially-paid or credited invoice must not
  /// count as if it were paid in full.
  amountPaidMinor      Int       @map("amount_paid_minor")
  currency             String
  /// Stripe's invoice status at capture (`paid`).
  status               String
  /// Why Stripe raised it (`subscription_create`, `subscription_cycle`, …) —
  /// distinguishes a first payment from a renewal without another API call.
  billingReason        String?   @map("billing_reason")
  periodStart          DateTime? @map("period_start")
  periodEnd            DateTime? @map("period_end")
  /// When it was actually paid, from Stripe — not when we recorded it, so a
  /// backfill lands each invoice on its real date.
  paidAt               DateTime  @map("paid_at")
  hostedInvoiceUrl     String?   @map("hosted_invoice_url")
  invoicePdfUrl        String?   @map("invoice_pdf_url")
  createdAt            DateTime  @default(now()) @map("created_at")

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  /// The customer page's "total spend + recent invoices, newest first".
  @@index([accountId, paidAt])
  /// Platform revenue by month.
  @@index([paidAt])
  @@map("subscription_invoices")
}

enum WalletEntryType {
  topup
  charge
  refund
  adjustment
}

/// Append-only. Never UPDATE or DELETE a row — corrections are new entries
/// (type=adjustment), so the ledger is always a reliable audit trail.
model WalletLedgerEntry {
  id                String          @id @default(uuid())
  accountId         String          @map("account_id")
  type              WalletEntryType
  amountMinor       Int             @map("amount_minor")
  balanceAfterMinor Int             @map("balance_after_minor")
  reference         String?
  /// Stripe's generated VAT invoice for a top-up (Stripe holds the VAT/company
  /// details, like every other receipt). Captured when the top-up is credited.
  /// Only ever set on `topup` entries. See docs/adr/0103-wallet-topup-receipts.md.
  stripeInvoiceId   String?         @map("stripe_invoice_id")
  /// Stripe hosted invoice page (view online).
  receiptUrl        String?         @map("receipt_url")
  /// Stripe generated invoice PDF (the downloadable VAT receipt).
  receiptPdfUrl     String?         @map("receipt_pdf_url")
  createdAt         DateTime        @default(now()) @map("created_at")

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, createdAt])
  @@map("wallet_ledger_entries")
}

/// Per-plan limits and feature gates, enforced centrally in the API rather
/// than scattered ad-hoc checks (e.g. the legacy "you can add 12 more
/// contacts" banner and the Pro-only auto-send gate).
model PlanEntitlement {
  planId               String  @id @map("plan_id")
  recipientCap         Int?    @map("recipient_cap") // null = unlimited
  batchOrderMaxSize    Int     @default(20) @map("batch_order_max_size")
  cardDiscountPercent  Decimal @default(0) @map("card_discount_percent") @db.Decimal(5, 2)
  autoSendEnabled      Boolean @default(false) @map("auto_send_enabled")
  /// Whether the plan may upload its own artwork as a custom card design
  /// (rather than only personalising catalog templates). See docs/adr/0026.
  customArtworkEnabled Boolean @default(false) @map("custom_artwork_enabled")
  /// Whether the plan may invite additional team members (multi-user org).
  /// Centre-tier only today. See docs/adr/0028-multi-user-teams.md.
  teamSeatsEnabled     Boolean @default(false) @map("team_seats_enabled")
  /// Team seats included in the plan's base price before per-seat charges kick
  /// in (Centre includes 3; single-user plans 1). See docs/adr/0035-seat-based-billing.md.
  includedSeats        Int     @default(1) @map("included_seats")
  /// Whether the plan may create QR message pages. Paid plans only (off for
  /// free). See docs/adr/0132-message-pages-v2.md.
  messagePagesEnabled  Boolean @default(false) @map("message_pages_enabled")
  /// Null for the free plan, which has no Stripe subscription object at all.
  stripePriceId        String? @map("stripe_price_id")

  @@map("plan_entitlements")
}

// ---------------------------------------------------------------------------
// Fulfillment — v1 is an internal ops queue (manual print/post); this shape
// is provider-agnostic so a real print-API vendor can be plugged in later.
// ---------------------------------------------------------------------------

enum FulfillmentJobStatus {
  pending
  in_progress
  printed
  posted
  delivered
  returned_to_sender
  failed
}

model FulfillmentJob {
  id                     String               @id @default(uuid())
  orderRecipientId       String               @unique @map("order_recipient_id")
  status                 FulfillmentJobStatus @default(pending)
  assignedToUserId       String?              @map("assigned_to_user_id")
  printedAt              DateTime?            @map("printed_at")
  postedAt               DateTime?            @map("posted_at")
  deliveredAt            DateTime?            @map("delivered_at")
  trackingReference      String?              @map("tracking_reference")
  /// The printable Royal Mail label/QR URL, when a shipment was auto-created via
  /// the Shipping API. Null for manually-dispatched jobs. See ADR 0072.
  labelUrl               String?              @map("label_url")
  /// Royal Mail's identifier for this card once it's been imported into the
  /// operator's Click & Drop dashboard queue. Null until pushed (or if Click &
  /// Drop import is off). Its presence is the idempotency guard — a card is never
  /// pushed twice. See ADR 0095.
  clickAndDropOrderId    String?              @map("click_and_drop_order_id")
  /// The last Click & Drop import error for this card, if the push failed — shown
  /// in the ops queue so an operator can retry. Cleared on a successful push.
  clickAndDropError      String?              @map("click_and_drop_error")
  /// When this card was imported into Click & Drop (the moment clickAndDropOrderId
  /// was stored). A precise import timestamp for the ops readout, distinct from
  /// updatedAt which any later change would move. Null until imported. See ADR 0114.
  clickAndDropImportedAt DateTime?            @map("click_and_drop_imported_at")
  /// The date this card must be POSTED by — denormalised from the occasion's
  /// dispatchDate at settlement (see batchOrders.settleFulfillment), so the ops
  /// queue can sort and bucket by send-urgency with an indexed range scan rather
  /// than joining through order_recipients → occasions on every read. Null when
  /// the card has no occasion (a bespoke send with no date-driven deadline);
  /// those sort last. See docs/adr/0108-dispatch-date-queue.md.
  dueDate                DateTime?            @map("due_date") @db.Date
  createdAt              DateTime             @default(now()) @map("created_at")
  updatedAt              DateTime             @updatedAt @map("updated_at")

  orderRecipient OrderRecipient @relation(fields: [orderRecipientId], references: [id], onDelete: Cascade)

  // The queue's spine: filter by status, order/range by dueDate. See ADR 0108.
  @@index([status, dueDate])
  @@map("fulfillment_jobs")
}

// ---------------------------------------------------------------------------
// Returned to Sender (RTS) — service recovery for cards Royal Mail sends back.
// See docs/adr/0039-returned-to-sender.md.
// ---------------------------------------------------------------------------

/// Why Royal Mail returned a card. Chosen by the ops operator who marks the RTS.
enum ReturnReason {
  moved
  incomplete_address
  incorrect_address
  undeliverable
  other
}

/// The stage of a return case's recovery workflow:
/// awaiting_address → (customer updates the contact's address) → awaiting_resend
/// → (customer resends / hand-delivers / archives) → resolved | archived.
enum ReturnCaseStatus {
  awaiting_address
  awaiting_resend
  resolved
  archived
}

/// One returned card and its recovery. Created when ops marks a card Returned to
/// Sender; drives the customer's Update-Address → resend/hand-deliver flow, the
/// contact's address-verification flag, and the ops RTS queue. The Kudos Promise
/// gives exactly one **free** (£0) recovery per case (freeRecoveryUsed); further
/// resends need a fresh paid order. See docs/adr/0039-returned-to-sender.md.
model ReturnCase {
  id               String           @id @default(uuid())
  accountId        String           @map("account_id")
  /// The card that came back. One case per returned card.
  orderRecipientId String           @unique @map("order_recipient_id")
  recipientId      String           @map("recipient_id")
  reason           ReturnReason
  status           ReturnCaseStatus @default(awaiting_address)
  /// The one Kudos Promise free recovery — set true once used (resend or hand-deliver).
  freeRecoveryUsed Boolean          @default(false) @map("free_recovery_used")
  /// When the customer updated the contact's address after the return.
  addressUpdatedAt DateTime?        @map("address_updated_at")
  resolvedAt       DateTime?        @map("resolved_at")
  /// How it closed: "resend_recipient" | "send_business" | "archived".
  resolution       String?
  /// The free recovery BatchOrder created for the resend/hand-deliver, if any.
  recoveryOrderId  String?          @map("recovery_order_id")
  /// The ops operator (PlatformAdmin userId) who marked the card returned.
  markedByUserId   String           @map("marked_by_user_id")
  /// Secret token in the customer's RTS email link — lets them update the
  /// address and recover the card without logging in. Never returned by the
  /// account-scoped API; only embedded in the email. See ADR 0039.
  publicToken      String?          @unique @map("public_token")
  returnedAt       DateTime         @default(now()) @map("returned_at")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  account        Account        @relation(fields: [accountId], references: [id], onDelete: Cascade)
  orderRecipient OrderRecipient @relation(fields: [orderRecipientId], references: [id], onDelete: Cascade)
  recipient      Recipient      @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  // Customer's open-cases lookup (contact alerts) and the ops queue's status filter.
  @@index([accountId, status])
  // Ops RTS queue: open cases first, oldest return first ("days since return").
  @@index([status, returnedAt])
  @@map("return_cases")
}

/// A Kudos Cards internal operator, distinct from a tuition centre's Membership.
/// Presence here grants cross-account access to the ops surfaces via
/// PlatformAdminGuard — see docs/adr/0010 and docs/adr/0040-admin-auth.md.
/// userId is the Supabase auth user id, same source as Membership.userId.
model PlatformAdmin {
  id        String   @id @default(uuid())
  userId    String   @unique @map("user_id")
  /// "super_admin" (manages the operator team + platform settings) or "ops"
  /// (works dashboards + fulfillment/returns queues). See ADR 0040.
  role      String   @default("ops")
  /// The operator's email, captured on first admin sign-in, for the team UI.
  email     String?
  createdAt DateTime @default(now()) @map("created_at")

  @@map("platform_admins")
}

/// An in-app notification for the Kudos HQ ops team — the platform-admin
/// equivalent of the account Notification inbox (ADR 0034), but scoped to
/// operators rather than an account's members. A platform-wide event (e.g. the
/// daily send-by-5 dispatch reminder, ADR 0115) fans out one row per operator so
/// read state (readAt) is per-user. `userId` is the operator's Supabase auth user
/// id — not a Prisma FK, same as PlatformAdmin.userId / Notification.userId.
/// entityType/entityId keep a producer idempotent under retries (a re-fired cron
/// records the same real-world event once). See ADR 0116.
model PlatformNotification {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  kind       String
  title      String
  body       String
  href       String?
  entityType String?   @map("entity_type")
  entityId   String?   @map("entity_id")
  readAt     DateTime? @map("read_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  // The unread badge + each operator's inbox list, both newest-first per user.
  @@index([userId, createdAt])
  // Idempotency lookup: has this event already been fanned out to operators?
  @@index([kind, entityId])
  @@map("platform_notifications")
}

/// An email allow-listed by a super admin to become an operator. When a user
/// signs in at the admin login with a matching *verified* Supabase email, they
/// are provisioned as a PlatformAdmin (role copied from here) and this row is
/// consumed. Mirrors the team-invite trust model without an email round-trip.
/// See docs/adr/0040-admin-auth.md.
model PlatformAdminInvite {
  id              String   @id @default(uuid())
  /// Lowercased email; unique so an address is invited at most once.
  email           String   @unique
  role            String   @default("ops")
  invitedByUserId String   @map("invited_by_user_id")
  createdAt       DateTime @default(now()) @map("created_at")

  @@map("platform_admin_invites")
}

/// A small key→value store for platform-level runtime config the app can write
/// itself — things that would otherwise need a redeploy to change. Today it
/// holds the Stripe extra-seat Price id created by the in-app provisioning
/// action (so seats activate with no env var / redeploy). An env var of the
/// same name still takes precedence. See docs/adr/0037-in-app-price-provisioning.md.
model PlatformSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("platform_settings")
}

// ---------------------------------------------------------------------------
// Compliance
// ---------------------------------------------------------------------------

/// Records who accessed/exported recipient (children's) personal data — a
/// UK GDPR non-negotiable, not optional polish. Written by the API layer,
/// never the client.
model AuditLogEntry {
  id          String   @id @default(uuid())
  accountId   String   @map("account_id")
  actorUserId String   @map("actor_user_id")
  action      String
  targetType  String   @map("target_type")
  targetId    String   @map("target_id")
  metadata    Json?
  createdAt   DateTime @default(now()) @map("created_at")

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, createdAt])
  @@index([targetType, targetId])
  @@map("audit_log_entries")
}

// ---------------------------------------------------------------------------
// Support ticketing
// ---------------------------------------------------------------------------

/// Whose turn it is on a support ticket. A customer message (new ticket or a
/// reply) leaves it `open` (support to act); a support reply moves it to
/// `awaiting_customer`. `resolved` is support marking it done — a customer reply
/// reopens it to `open`. `closed` is terminal. See docs/adr/0066-support-ticketing.md.
enum SupportTicketStatus {
  open
  awaiting_customer
  resolved
  closed
}

/// Coarse topic the subscriber picks when raising a ticket, so support can
/// triage and filter the queue.
enum SupportTicketCategory {
  billing
  orders
  design
  account
  other
}

/// Support-set urgency. Defaults to `normal`; the customer never sets it.
enum SupportTicketPriority {
  low
  normal
  high
  urgent
}

/// Which side authored a ticket message.
enum SupportMessageAuthor {
  customer
  support
}

/// The kind of file attached to a support message, so the UI knows whether to
/// render an image thumbnail or a video player.
enum SupportAttachmentKind {
  image
  video
}

/// A support conversation opened by a subscriber and worked by the Kudos support
/// team in the ops portal. The thread of back-and-forth lives in
/// SupportTicketMessage. See docs/adr/0066-support-ticketing.md.
model SupportTicket {
  id               String                @id @default(uuid())
  /// Human-friendly sequential reference (rendered as TKT-1000). Sequence starts
  /// at 1000 (see the migration), mirroring BatchOrder.orderNumber.
  ticketNumber     Int                   @unique @default(autoincrement()) @map("ticket_number")
  accountId        String                @map("account_id")
  /// The Supabase auth user (a member of the account) who opened the ticket.
  createdByUserId  String                @map("created_by_user_id")
  subject          String
  category         SupportTicketCategory @default(other)
  priority         SupportTicketPriority @default(normal)
  status           SupportTicketStatus   @default(open)
  /// The ops user (PlatformAdmin.userId) currently handling it, if claimed.
  assignedToUserId String?               @map("assigned_to_user_id")
  /// Best-effort technical context captured silently from the browser when the
  /// ticket was raised (page URL, user agent, viewport, app version, plan). Ops-
  /// only — never shown to the customer. Speeds up triage so support doesn't have
  /// to ask "which page? which browser?". See docs/adr/0079-support-attachments.md.
  diagnostics      Json?                 @map("diagnostics")
  /// Denormalised so the queue can sort by "most recent activity" and show
  /// "whose turn" without loading the whole message thread.
  lastMessageAt    DateTime              @default(now()) @map("last_message_at")
  lastMessageFrom  SupportMessageAuthor  @default(customer) @map("last_message_from")
  resolvedAt       DateTime?             @map("resolved_at")
  closedAt         DateTime?             @map("closed_at")
  createdAt        DateTime              @default(now()) @map("created_at")
  updatedAt        DateTime              @updatedAt @map("updated_at")

  account  Account                @relation(fields: [accountId], references: [id], onDelete: Cascade)
  messages SupportTicketMessage[]

  // The subscriber's own tickets list (newest first).
  @@index([accountId, createdAt])
  // The ops queue: status filter + oldest-activity-first working order.
  @@index([status, lastMessageAt])
  @@map("support_tickets")
}

/// One message in a support ticket thread — from the customer or from support.
/// `internalNote` messages are support-only (triage/context) and are never
/// returned to the customer side.
model SupportTicketMessage {
  id           String               @id @default(uuid())
  ticketId     String               @map("ticket_id")
  authorType   SupportMessageAuthor @map("author_type")
  /// The authoring Supabase auth user (member or ops); null for system messages.
  authorUserId String?              @map("author_user_id")
  body         String
  /// Support-only note, hidden from the customer. Always false for customer messages.
  internalNote Boolean              @default(false) @map("internal_note")
  createdAt    DateTime             @default(now()) @map("created_at")

  ticket      SupportTicket                    @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  attachments SupportTicketMessageAttachment[]

  @@index([ticketId, createdAt])
  @@map("support_ticket_messages")
}

/// A screenshot or screen recording a customer attached to a support message, so
/// they can *show* the problem rather than only describe it. Stored in the
/// `support-attachments` bucket (public-read, unguessable path — same model as
/// the other upload buckets). See docs/adr/0079-support-attachments.md.
model SupportTicketMessageAttachment {
  id          String                @id @default(uuid())
  messageId   String                @map("message_id")
  /// Public storage URL of the uploaded file. Legacy: kept so attachments
  /// created before `path` existed still resolve, and dropped once every row
  /// has been backfilled. New rows are served from `path` instead and leave
  /// this null — the bucket is private, so there is no public URL to store.
  url         String?
  /// Object path inside the support-attachments bucket, `{accountId}/{file}`.
  ///
  /// The bucket is private, so a URL can't be stored — reads mint a short-lived
  /// signed URL from this path instead. The leading segment is the owning
  /// account, which is what makes a read authorisable without another lookup.
  path        String?
  /// Original filename, for the download label.
  fileName    String                @map("file_name")
  contentType String                @map("content_type")
  sizeBytes   Int                   @map("size_bytes")
  kind        SupportAttachmentKind
  createdAt   DateTime              @default(now()) @map("created_at")

  message SupportTicketMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@map("support_ticket_message_attachments")
}

/// Triage state of an Enterprise "Contact us" lead.
enum EnterpriseEnquiryStatus {
  new
  in_progress
  closed
}

/// A sales lead from the public Enterprise pricing option ("Contact us"). Kudos
/// Enterprise isn't self-serve — no Stripe object — so a visitor submits an
/// enquiry here, ops get emailed and work it from the admin portal, then set the
/// account up by hand. Submitted by unauthenticated visitors, so it holds only
/// what the form collects (no account relation). See
/// docs/adr/0101-enterprise-plan-enquiries.md.
model EnterpriseEnquiry {
  id              String                  @id @default(uuid())
  name            String
  email           String
  organisation    String
  phone           String?
  /// Rough size the visitor typed, e.g. "500 students" — free text, optional.
  teamSize        String?                 @map("team_size")
  message         String
  status          EnterpriseEnquiryStatus @default(new)
  /// The ops user (PlatformAdmin.userId) who last changed the status — a light
  /// audit trail. Null until someone works it.
  handledByUserId String?                 @map("handled_by_user_id")
  createdAt       DateTime                @default(now()) @map("created_at")
  updatedAt       DateTime                @updatedAt @map("updated_at")

  // The ops queue: status filter, newest first.
  @@index([status, createdAt])
  @@map("enterprise_enquiries")
}
