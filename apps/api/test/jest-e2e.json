{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "setupFilesAfterEnv": ["<rootDir>/util/reset-between-suites.ts"],
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": [
      "ts-jest",
      {
        "tsconfig": "<rootDir>/../tsconfig.spec.json"
      }
    ]
  },
  "maxWorkers": 1,
  "transformIgnorePatterns": [
    "^(?!.*\\.pnpm/(?:dom-serializer|domelementtype|domhandler|domutils|entities|htmlparser2|nanoid)@).*node_modules"
  ]
}
