{
  "name": "kudos-platform",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,cjs,md,json,css,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,cjs,md,json,css,yml,yaml}\"",
    "adr:index": "node scripts/build-adr-index.mjs",
    "adr:index:check": "node scripts/build-adr-index.mjs --check",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^15.2.10",
    "prettier": "^3.3.3",
    "turbo": "^2.1.3",
    "typescript": "^5.6.3"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs,md,json,css,yml,yaml}": [
      "prettier --write"
    ],
    "{apps,packages}/**/*.{ts,tsx,mjs,cjs,js}": [
      "node scripts/lint-staged-eslint.mjs"
    ]
  },
  "pnpm": {
    "overrides": {
      "browserslist": ">=4.28.7",
      "fast-uri": ">=4.1.3",
      "js-yaml": ">=4.3.1",
      "postcss": ">=8.5.23",
      "sharp": ">=0.35.3"
    }
  }
}
